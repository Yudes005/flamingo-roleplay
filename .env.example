# ============================================================
#  Ove promenljive se upisuju u Vercel -> Settings -> Environment Variables
#  (NE u kod). Za lokalno pokretanje kopiraj ovaj fajl u .env.local
# ============================================================

# --- OBAVEZNO ---
SITE_URL=https://flamingo-roleplay.vercel.app
# bilo koji dugačak nasumičan tekst (bar 32 znaka) - čuva sesije od lažiranja
SESSION_SECRET=
# Discord aplikacija (već imaš od starog sajta)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# token bota (isti bot kao flamingo_invitebot) + ID Discord servera
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# baza - Vercel -> Storage -> Neon je sam upiše
DATABASE_URL=

# --- PRIJAVE I PANEL ---
# kanal gde bot javlja novu prijavu (samo staff)
DISCORD_PRIJAVE_KANAL_ID=
# ID-jevi uloga odvojeni zarezom: ko čita/glasa, ko odlučuje
PANEL_ROLE_IDS=
PANEL_ODLUKA_ROLE_IDS=
# tvoj Discord ID (uvek ima pun pristup panelu)
VLASNIK_DISCORD_IDS=
# uloga koju bot da kad prihvatiš prijavu (prazno = ne daje)
PRIJAVA_ADMIN_ROLE_ID=
PRIJAVA_SUPPORT_ROLE_ID=
PRIJAVA_LIDER_ROLE_ID=

# --- STRANA "TIM" (ID uloga) ---
TIM_VLASNIK_ROLE_ID=
TIM_HEADADMIN_ROLE_ID=
TIM_ADMIN_ROLE_ID=
TIM_SUPPORT_ROLE_ID=
TIM_DEV_ROLE_ID=
