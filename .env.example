# ============================================================
#  Ove promenljive se upisuju u Vercel -> Settings -> Environment Variables
#  (NE u kod). Za lokalno pokretanje kopiraj ovaj fajl u .env.local
#  Posle svake izmene u Vercelu: Deployments -> ... -> Redeploy
#  Šta fali vidiš na adresi /provera
# ============================================================

# --- OBAVEZNO ZA LOGIN ---
SITE_URL=https://flamingo-roleplay.vercel.app
# bilo koji dugačak nasumičan tekst (bar 32 znaka) - čuva sesije od lažiranja
SESSION_SECRET=
# Discord aplikacija (Developer Portal -> OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- BAZA (prijave, reportovi, novosti, predlozi) ---
# Vercel -> Storage -> Neon je sam upiše
DATABASE_URL=

# --- DISCORD BOT (isti bot kao flamingo_invitebot) ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# kanal gde bot javlja nove prijave (samo staff)
DISCORD_PRIJAVE_KANAL_ID=
# kanal za reportove i bagove (prazno = idu u kanal za prijave)
DISCORD_REPORT_KANAL_ID=
# javni kanal za novosti (staff štiklira "objavi i na Discordu")
DISCORD_NOVOSTI_KANAL_ID=

# --- STAFF PANEL ---
# ID-jevi uloga odvojeni zarezom: ko čita/glasa, ko odlučuje i piše novosti
PANEL_ROLE_IDS=
PANEL_ODLUKA_ROLE_IDS=
# tvoj Discord ID (uvek ima pun pristup panelu i dobija reportove na staff u DM)
VLASNIK_DISCORD_IDS=

# --- ULOGE KOJE BOT DAJE KAD PRIHVATIŠ PRIJAVU (prazno = ne daje) ---
PRIJAVA_ADMIN_ROLE_ID=
PRIJAVA_SUPPORT_ROLE_ID=
PRIJAVA_DEV_ROLE_ID=
PRIJAVA_LIDER_ROLE_ID=
PRIJAVA_KREATOR_ROLE_ID=

# --- STRANA "TIM" (ID uloga) ---
TIM_VLASNIK_ROLE_ID=
TIM_HEADADMIN_ROLE_ID=
TIM_ADMIN_ROLE_ID=
TIM_SUPPORT_ROLE_ID=
TIM_DEV_ROLE_ID=
